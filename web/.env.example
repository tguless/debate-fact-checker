# Next.js reads this file (web/.env). Copy to web/.env and add your keys.
# Tip: you can also keep a root .env — start.sh syncs it here on launch.

# Project ports — change if these clash with other apps on your machine
DFC_APP_PORT=3847
DFC_POSTGRES_PORT=5487
PORT=3847

DATABASE_URL="postgresql://dfc:dfc_dev_password@localhost:5487/debate_fact_checker?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3847"

# ── REQUIRED for /agent (bring your own keys — we never ship these) ──
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Tavily: https://tavily.com — search + full-page extract for fact-checking
TAVILY_API_KEY="tvly-..."

OPENAI_MODEL="gpt-4.1-mini"
AGENT_MAX_STEPS=50

# Optional fallback search (Tavily is preferred)
SERPER_API_KEY=""
